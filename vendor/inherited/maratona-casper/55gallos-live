#! /bin/sh
# GallosOS casper-bottom hook, adapted from maratona-linux/maratona-casper's
# 55maratona-fixes (GPLv2, see ./LICENSE in this directory) — commit
# bdd6b117f3c734d192225446520bcba459d3d33b, 2018-10-29,
# https://github.com/maratona-linux/maratona-casper
#
# Original: mopped up snapd state, seeded /home/icpc, and branched on
# /proc/cmdline flags (factoryreset/mlinstall/mlshell) for install-media
# workflows. This adaptation keeps the casper-bottom hook shape
# (PREREQ/prereqs()/casper-functions/log_begin_msg) and the home-directory
# seeding pattern, retargeted at GallosOS's canonical `contestant` user
# (see README.md § Terminology). The base squashfs + tmpfs overlay mount
# itself is casper's own stock behavior (scripts/casper), not reimplemented
# here.
#
# ROADMAP.md Phase 1 "Casper Live Boot Engine" status: this hook now
# covers GALLOS_BOOT config exposure and Ventoy gallos.toml detection.
# Two sub-items are deliberately NOT handled here, by design, not because
# they're unfinished:
#   - .gsm SquashFS module mounting: happens one boot stage earlier, as a
#     build-time patch to casper's own setup_overlay() (see
#     vendor/inherited/maratona-casper/casper-gsm-overlay.sh) — by the
#     time this casper-bottom hook runs, the overlay is already mounted
#     and casper-bottom can no longer add lowerdir= layers.
#   - event-data partition mount-by-label: owned by gallos-daemon
#     (daemon/src/storage.py), not casper, because mounting it is
#     mode-aware (Contest never mounts it) and that precedence logic
#     already lives in the Python ModeStateMachine — see
#     docs/ARCHITECTURE.md §4 item 5.
#   - toram: already stock upstream Ubuntu casper behavior
#     (scripts/casper's copy_live_to()), not GallosOS-authored.

# shellcheck shell=sh
# shellcheck disable=SC1091,SC2154

PREREQ=""
DESCRIPTION="Setting up GallosOS live environment..."

prereqs()
{
       echo "$PREREQ"
}

case $1 in
prereqs)
       prereqs
       exit 0
       ;;
esac

. /scripts/casper-functions
. /scripts/casper-helpers

log_begin_msg "$DESCRIPTION"

# Make sure the contestant home directory exists even if no .gsm module or
# earlier hook has created it yet.
if [ ! -d "${rootmnt}/home/contestant" ]; then
  mkdir -p "${rootmnt}/home/contestant"
  chown 1000:1000 "${rootmnt}/home/contestant" 2>/dev/null || true
fi

# GALLOS_BOOT config exposure: 05mountpoints (an earlier casper-bottom
# hook, numeric order 05 < 55) already move-mounts the live medium to
# ${rootmnt}/cdrom, which becomes /cdrom in the final booted system.
# Symlink /boot/gallos there so daemon/src/config.py's
# /boot/gallos/config/{gallos,machine}.toml candidates resolve to the
# GALLOS_BOOT partition's /gallos/config/ directory
# (docs/BUILD_SYSTEM.md's canonical layout) with no extra mount.
if [ -d "${rootmnt}/cdrom/gallos" ] && [ ! -e "${rootmnt}/boot/gallos" ]; then
  mkdir -p "${rootmnt}/boot"
  ln -s /cdrom/gallos "${rootmnt}/boot/gallos"
fi

# Ventoy gallos.toml auto-detection (docs/ARCHITECTURE.md §9.4 "Ventoy
# Multi-Boot USBs" / §4 item 5). We don't fingerprint Ventoy itself — its
# data-partition label is organizer-configurable at install time, not
# fixed — we just look for any other already-available block device
# carrying /gallos/gallos.toml at its filesystem root, which is exactly
# what the architecture doc promises: "auto-loads any /gallos/gallos.toml
# placed alongside the ISO." Single-pass, no retries: unlike
# casper-premount's find_path() (designed for devices that may not be
# settled yet), every device is already available by casper-bottom time,
# so a retry/sleep loop here would only add latency to every boot that
# isn't using Ventoy. Copies the file into rootmnt rather than symlinking
# to the scan mountpoint: unlike /cdrom (explicitly move-mounted into
# rootmnt by 05mountpoints above, so it survives the root switch), a
# plain mount done directly under rootmnt here does not reliably survive
# run-init's switch into the final root — verified via QEMU boot test,
# where a symlink to it resolved during casper-bottom but dangled
# post-boot. A copied file has no such dependency.
if [ ! -e "${rootmnt}/gallos/gallos.toml" ]; then
  gallos_ventoy_mnt="${rootmnt}/gallos-ventoy"
  mkdir -p "$gallos_ventoy_mnt"
  for gallos_sysblock in $(echo /sys/block/* | tr ' ' '\n' | grep -v /ram | grep -v /loop | grep -v /fd); do
    for gallos_subdev in $(subdevices "${gallos_sysblock}"); do
      gallos_devname=$(sys2dev "${gallos_subdev}")
      gallos_fstype=$(get_fstype "${gallos_devname}")
      # Deliberately not gated on casper-helpers' is_supported_fs(): its
      # whitelist omits exfat, which is Ventoy's default data-partition
      # format, so that check would silently skip the exact case this
      # scan exists for. Accept any fstype the kernel itself recognized.
      [ -n "${gallos_fstype}" ] && [ "${gallos_fstype}" != "unknown" ] || continue
      # Skip devices already mounted (e.g. GALLOS_BOOT itself, handled
      # above) rather than second-guessing an existing mount.
      grep -q "^${gallos_devname} " /proc/mounts && continue
      try_mount "${gallos_devname}" "${gallos_ventoy_mnt}" ro || continue
      if [ -f "${gallos_ventoy_mnt}/gallos/gallos.toml" ]; then
        mkdir -p "${rootmnt}/gallos"
        cp "${gallos_ventoy_mnt}/gallos/gallos.toml" "${rootmnt}/gallos/gallos.toml"
        umount "${gallos_ventoy_mnt}" 2>/dev/null || true
        break 2
      fi
      umount "${gallos_ventoy_mnt}" 2>/dev/null || true
    done
  done
fi

log_end_msg
