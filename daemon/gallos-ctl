#!/usr/bin/env python3
"""Organizer CLI Control utility for GallosOS Daemon."""

import os
import socket
import sys


SOCKET_PATH = "/run/gallos/daemon.sock"


def send_command(cmd: str) -> None:
    if not os.path.exists(SOCKET_PATH):
        print(f"Error: GallosOS Daemon is not running (socket {SOCKET_PATH} not found).", file=sys.stderr)
        sys.exit(1)

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.connect(SOCKET_PATH)
            client.sendall((cmd + "\n").encode("utf-8"))
            resp = client.recv(4096).decode("utf-8")
            print(resp.strip())
    except Exception as e:
        print(f"Error communicating with GallosOS Daemon: {e}", file=sys.stderr)
        sys.exit(1)


def main() -> None:
    if len(sys.argv) < 2:
        print("Usage: gallos-ctl [contest start [mins] | contest stop | status | reload]")
        sys.exit(1)

    cmd_type = sys.argv[1].lower()

    if cmd_type == "contest":
        if len(sys.argv) < 3:
            print("Usage: gallos-ctl contest [start [mins] | stop]")
            sys.exit(1)
        sub = sys.argv[2].lower()
        if sub == "start":
            dur = sys.argv[3] if len(sys.argv) > 3 else "300"
            send_command(f"START {dur}")
        elif sub == "stop":
            send_command("STOP")
        else:
            print(f"Unknown contest subcommand: {sub}")
            sys.exit(1)

    elif cmd_type == "status":
        send_command("STATUS")
    elif cmd_type == "reload":
        send_command("RELOAD")
    else:
        print(f"Unknown command: {cmd_type}")
        sys.exit(1)


if __name__ == "__main__":
    main()
